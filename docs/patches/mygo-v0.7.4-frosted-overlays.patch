+// A backdrop filter replaces the previous sample, including its alpha.
+func blendBackdrop(p []byte, c [4]float32, cov float32) {
+	for i := range 4 {
+		channel := i
+		if i < 3 {
+			channel = 2 - i
+		}
+		p[i] = to8(c[channel]*cov + float32(p[i])/255*(1-cov))
+	}
+}
